# Application Configuration

APP_NAME=EngageAI
APP_VERSION=1.0.0
DEBUG=True

# Database Configuration

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=engageai

DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/engageai

# JWT Authentication

SECRET_KEY=your_super_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Groq API

GROQ_API_KEY=your_groq_api_key

# Machine Learning

MODEL_PATH=ml/saved_models

# RAG Configuration

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_PATH=app/ai/rag/vector_store

# Logging

LOG_LEVEL=INFO